                                  "lineHeight": 1.15,
                                  "fontFamily": "$font-sans",
                                  "fontSize": 30,
                                  "fontWeight": "700",
                                  "letterSpacing": -0.7
                                },
                                {
                                  "type": "text",
                                  "id": "HLUIN",
                                  "name": "subtitle",
                                  "fill": "$--muted-foreground",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Distilled from Harrison Chase (LangChain) × Pi. A checklist for deterministic planning, tool calling and state ownership.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$font-sans",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                },
                                {
                                  "id": "OaBAC",
                                  "type": "ref",
                                  "ref": "Zk8lN",
                                  "name": "Quote",
                                  "width": "fill_container"
                                },
                                {
                                  "type": "frame",
                                  "id": "aGn2k",
                                  "name": "Body",
                                  "width": "fill_container",
                                  "layout": "vertical",
                                  "gap": "$spacing-16",
                                  "padding": [
                                    12,
                                    0,
                                    0,
                                    0
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "I445C",
                                      "name": "p1",
                                      "fill": "$--primary",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "The harness owns the loop — not the model. Pi keeps the model as a stateless function and lets the harness decide what to load, when to act, and when to persist. That inversion is what makes long-running, file-heavy work tractable.",
                                      "lineHeight": 1.7,
                                      "fontFamily": "$font-sans",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "Z7Q6iY",
                                      "name": "h2 section",
                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "gap": "$spacing-8",
                                      "padding": [
                                        16,
                                        0,
                                        0,
                                        0
                                      ],
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "qFHXg",
                                          "name": "h2",
                                          "fill": "$--primary",
                                          "content": "1. One loop, one state owner",
                                          "fontFamily": "$font-sans",
                                          "fontSize": 16,
                                          "fontWeight": "700",
                                          "letterSpacing": -0.2
                                        },
                                        {
                                          "type": "text",
                                          "id": "oAHkI",
                                          "name": "p",
                                          "fill": "$--primary",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "A single top-level agent owns the workflow. Child agents are spawned in the same process tree and return structured output — they never write to disk directly. The parent validates, merges, and decides what survives.",
                                          "lineHeight": 1.7,
                                          "fontFamily": "$font-sans",
                                          "fontSize": 14,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "XTuR5",
                                      "name": "Code",
                                      "width": "fill_container",
                                      "fill": "$--foreground",
                                      "cornerRadius": "$radius-8",
                                      "layout": "vertical",
                                      "gap": "$spacing-4",
                                      "padding": "$spacing-12",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "Y7ubTf",
                                          "name": "code head",
                                          "width": "fill_container",
                                          "gap": "$spacing-8",
                                          "padding": [
                                            0,
                                            0,
                                            8,
                                            0
