{
  "name": "knowledge-reader",
  "description": "Knowledge Web Projection reader: static Next.js reader over isolated staged Markdown (headless Fumadocs MDX content source, no Fumadocs UI)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "next build --webpack && node ./scripts/build-search-index.mjs && node ./scripts/build-offline.mjs",
    "dev": "next dev",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@flowershow/remark-wiki-link": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.3",
    "lucide-react": "^1.48.0",
    "minisearch": "^7",
    "next": "^16.3.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.3.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  }
