{
  "name": "knowledge-web-publisher",
  "description": "Knowledge Web Publisher: shared build machinery for read-only Web Projections of Knowledge Bases",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check": "pnpm exec prettier . --check",
    "lint": "oxlint",
    "format": "pnpm exec prettier . --write",
    "test": "tsx --test --test-concurrency=1",
    "test:reader": "tsx --test --test-concurrency=1 tests/knowledge-reader-static.test.mjs tests/knowledge-reader-journey-browser.test.mjs tests/knowledge-reader-phone-browser.test.mjs",
    "test:reader:browser": "tsx --test --test-concurrency=1 tests/knowledge-reader-journey-browser.test.mjs tests/knowledge-reader-phone-browser.test.mjs",
    "test:contract": "node --test --test-concurrency=1 'tests/*.test.mjs'"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog"
  ],
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@flowershow/remark-wiki-link": "^3.4.0",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^25.0.10",
    "oxlint": "1.85.0",
    "prettier": "^3.8.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.21.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
